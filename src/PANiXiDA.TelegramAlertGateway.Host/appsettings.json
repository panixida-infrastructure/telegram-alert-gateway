{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:8080",
        "Protocols": "Http1"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PostgreSqlConnectionString": "Host=localhost;Port=5432;Database=telegram_alert_gateway;Username=postgres"
  },
  "BackgroundProcessing": {
    "Enabled": true
  },
  "NotificationRetention": {
    "SentRetentionDays": 14,
    "FailedRetentionDays": 30,
    "BatchSize": 500,
    "CleanupIntervalHours": 24
  },
  "Webhook": {
    "Token": ""
  },
  "Telegram": {
    "BotToken": "",
    "ChatId": -1003738995665,
    "ProxyUrl": "http://telegram-vpn.observability.svc.cluster.local:8888",
    "Topics": {
      "tactical-heroes": 955,
      "dotnet-template": 956,
      "postgresql": 958,
      "core-platform": 960,
      "observability": 962,
      "unclassified-tests": 964
    }
  },
  "AlertRouting": {
    "DefaultTopic": "unclassified-tests",
    "Rules": [
      {
        "Topic": "tactical-heroes",
        "Matches": [ "tactical-heroes" ]
      },
      {
        "Topic": "dotnet-template",
        "Matches": [ "dotnet-template" ]
      },
      {
        "Topic": "postgresql",
        "Matches": [ "postgresql", "postgres", "pg-" ]
      },
      {
        "Topic": "observability",
        "Matches": [ "observability", "grafana", "victoria", "otel", "alertmanager", "telegram-alert-gateway" ]
      },
      {
        "Topic": "core-platform",
        "Matches": [ "core-platform", "argocd", "openbao", "keycloak", "cert-manager", "cilium" ]
      }
    ]
  },
  "VictoriaLogs": {
    "Endpoint": "http://victorialogs.observability.svc.cluster.local:9428",
    "Username": "",
    "Password": "",
    "Query": "severity_text:(i(error) OR i(fatal) OR i(critical)) OR severity:(i(error) OR i(fatal) OR i(critical)) OR level:(i(error) OR i(fatal) OR i(critical)) OR \"log.level\":(i(error) OR i(fatal) OR i(critical)) OR SeverityText:(i(error) OR i(fatal) OR i(critical)) OR LogLevel:(i(error) OR i(fatal) OR i(critical))",
    "PollIntervalSeconds": 60,
    "IngestionDelaySeconds": 15,
    "MaxEntriesPerWindow": 10000,
    "GrafanaLogsUrl": "https://grafana.panixida.ru/explore?left=%7B%22datasource%22:%22victorialogs%22%7D",
    "ExcludedServices": [ "telegram-alert-gateway" ]
  },
  "ScalarConfiguration": {
    "Title": "PANiXiDA Telegram Alert Gateway API Reference"
  },
  "OTEL_SERVICE_NAME": "telegram-alert-gateway",
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://otel-collector.observability.svc.cluster.local:4317"
}
